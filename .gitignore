# Secrets. `.env` is listed first because this repository once committed one containing a
# live API key. A rule here does nothing for an already-tracked file, so if you ever find a
# secret committed: rotate it first, then rewrite history. In that order.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local data: indexes and uploads are reproducible from the corpus, so they are not tracked.
*.sqlite
*.sqlite3
.ragkit/
uploads/
logs/

# Editors and OS
.vscode/
.idea/
.DS_Store
