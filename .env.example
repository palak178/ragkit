# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#
# This file exists because an earlier version of this repository committed a real `.env`
# containing a live OpenAI key and a Qdrant cluster key. Nothing here is a credential; every
# value is a placeholder or a default.
#
# Defaults are chosen so that a fresh clone works with no configuration at all: hashing
# embeddings, an in-memory store and the offline extractive stub. Everything below is opt-in.

# ---- Chunking -------------------------------------------------------------------------
# Characters, not tokens (roughly 4:1 for English prose).
RAGKIT_CHUNK_CHARS=1200
RAGKIT_CHUNK_OVERLAP_CHARS=200

# ---- Retrieval ------------------------------------------------------------------------
RAGKIT_TOP_K=5
# Minimum top-1 cosine similarity before the model is called. Tuned for the hashing
# embedder; re-run `python eval/run_eval.py --threshold ...` after switching embedder.
RAGKIT_SCORE_THRESHOLD=0.10

# ---- Embeddings -----------------------------------------------------------------------
# `hashing` (default, offline, lexical) or `sentence-transformers` (needs the `local` extra).
RAGKIT_EMBEDDER=hashing
RAGKIT_EMBEDDING_DIMENSIONS=512
# RAGKIT_EMBEDDER=sentence-transformers
# RAGKIT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector store ---------------------------------------------------------------------
# `memory` (default) or `qdrant` (needs the `qdrant` extra).
RAGKIT_STORE=memory
# RAGKIT_STORE=qdrant
# RAGKIT_QDRANT_URL=http://localhost:6333
# RAGKIT_QDRANT_API_KEY=
# RAGKIT_QDRANT_COLLECTION=ragkit

# ---- Generation -----------------------------------------------------------------------
# `echo` is the offline extractive stub and is NOT a language model. Use `openai` or
# `anthropic` for real prose; both need the matching extra installed.
RAGKIT_LLM=echo
# RAGKIT_LLM=openai
# RAGKIT_LLM_MODEL=gpt-4o-mini
# RAGKIT_OPENAI_API_KEY=sk-your-key-here
# RAGKIT_LLM=anthropic
# RAGKIT_LLM_MODEL=claude-sonnet-4-5
# RAGKIT_ANTHROPIC_API_KEY=sk-ant-your-key-here
RAGKIT_MAX_ANSWER_TOKENS=700
